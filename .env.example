# Export these variables into the training process. This file is not loaded automatically.
# On macOS, ~/.config/gymemu/r2.toml can reference credentials stored in Keychain instead.
# Use an R2 Object Read & Write token scoped only to the gymemu bucket.
GYMEMU_MODELS_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
GYMEMU_MODELS_R2_ACCESS_KEY_ID=
GYMEMU_MODELS_R2_SECRET_ACCESS_KEY=

# Separate Object Read & Write token scoped to the public inference bucket.
# On macOS, ~/.config/gymemu/public-r2.toml can reference its Keychain entries.
GYMEMU_PUBLIC_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
GYMEMU_PUBLIC_R2_ACCESS_KEY_ID=
GYMEMU_PUBLIC_R2_SECRET_ACCESS_KEY=
